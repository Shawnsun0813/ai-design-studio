{
  "name": "ai-design-studio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "AI design workbench: a running page, one design conversation, and reversible code changes written only through an execution layer",
  "scripts": {
    "start": "node server/main.mjs",
    "start:stub": "node server/main.mjs --stub",
    "typecheck": "tsc -p workbench/tsconfig.json --noEmit && tsc -p target-app/tsconfig.json --noEmit",
    "check:version": "node checks/code-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.0.10",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
